{
  "name": "backend_v3",
  "version": "1.0.0",
  "description": "IMENSIAH Backend v3 - Strategic Analysis Platform",
  "scripts": {
    "test": "go test -timeout 30s ./domain/... ./jobs/... -run '^Test' -short",
    "test:unit": "go test -timeout 30s ./domain/... ./jobs/... -run '^Test' -short",
    "test:integration": "go test -timeout 60s ./integration_tests/...",
    "test:all": "go test -timeout 60s ./...",
    "test:verbose": "go test -v -timeout 30s ./domain/... ./jobs/... ./integration_tests/...",
    "test:unit:verbose": "go test -v -timeout 30s ./domain/... ./jobs/... -run '^Test' -short",
    "test:integration:verbose": "go test -v -timeout 60s ./integration_tests/...",
    "test:coverage": "go test -timeout 60s -coverprofile=coverage.out ./... && go tool cover -html=coverage.out -o coverage.html",
    "test:quick": "go test -timeout 15s -short ./domain/... ./jobs/...",
    "test:failed": "go test -v -timeout 30s ./... -run '^(TestRepository_Create_WithAll11Frameworks|TestRepository_Create_JSONBSerialization|TestRepository_Update_Success|TestRepository_Update_NotFound|TestRepository_UpdateWithTx_TransactionHandling|TestRepository_GetLatestVersionBySubmissionID_OrdersByVersionDESC|TestEnrichmentWorkflow_Integration)$$'",
    "clean": "go clean -testcache && rm -f coverage.out coverage.html",
    "tidy": "go mod tidy"
  },
  "keywords": [
    "golang",
    "backend",
    "api",
    "strategic-analysis"
  ],
  "author": "IMENSIAH Team",
  "license": "MIT"
}
