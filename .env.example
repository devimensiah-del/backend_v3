# ==============================================
# SERVER SETTINGS
# ==============================================
# Port for the Go backend to listen on
SERVER_PORT=8080
# Environment: "development" or "production"
ENV=development
# The URL of your frontend (React/Next.js) for CORS
ALLOWED_ORIGINS=http://localhost:3000,https://your-production-domain.com

# ==============================================
# DATABASE (Supabase PostgreSQL)
# ==============================================
# Format: postgres://user:password@host:port/dbname?sslmode=disable
# Get this from Supabase -> Settings -> Database -> Connection String (Go)
DATABASE_URL=postgres://postgres.xxxx:password@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=require

# ==============================================
# AUTHENTICATION (Supabase Auth)
# ==============================================
# The Project URL
SUPABASE_URL=https://your-project-id.supabase.co

# CRITICAL: Two different keys are required:
# 1. Anon Key: Public key for making Auth API calls (signup/login/logout)
#    Found in: Supabase -> Settings -> API -> Project API keys -> anon public
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. JWT Secret: Secret for validating user tokens in AuthMiddleware
#    Found in: Supabase -> Settings -> API -> JWT Settings -> JWT Secret
SUPABASE_JWT_SECRET=super-secret-jwt-token-from-supabase-settings
# 3. Service Role Key: Required for private storage uploads (never expose to frontend)
#    Found in: Supabase -> Settings -> API -> Project API keys -> service_role
SUPABASE_SERVICE_ROLE_KEY=service-role-key-with-storage-rights
# Storage bucket used for reports (private)
SUPABASE_STORAGE_BUCKET=reports-pdf
# Signed URL TTL for report downloads (seconds)
SUPABASE_SIGNED_URL_TTL=604800

# ==============================================
# AI BRAIN (OpenRouter)
# ==============================================
# Key starting with "sk-or-..." (set as OPENAI_API_KEY for OpenRouter compatibility)
OPENAI_API_KEY=sk-or-your-openrouter-key

# ==============================================
# AI MODEL CONFIGURATION
# ==============================================
# Global fallback model - used when any primary model fails (rate limit, timeout, unavailable)
# This ensures analysis always completes, even if preferred models are temporarily unavailable
AI_FALLBACK_MODEL=openai/gpt-4o-mini

# ==============================================
# OPTIONAL: Framework-specific model overrides
# ==============================================
# By default, each framework uses optimized models with automatic fallback.
# Uncomment and modify only if you need to override specific frameworks.
#
# Discovery Layer:
# AI_ENRICHMENT_MODEL=google/gemini-2.0-flash-001
#
# Analysis Frameworks (defaults to gpt-4o or gpt-4o-mini based on task complexity):
# AI_PESTEL_MODEL=openai/gpt-4o
# AI_PORTER_MODEL=openai/gpt-4o
# AI_TAM_MODEL=openai/gpt-4o
# AI_SWOT_MODEL=openai/gpt-4o-mini
# AI_BENCHMARKING_MODEL=openai/gpt-4o-mini
# AI_BLUE_OCEAN_MODEL=openai/gpt-4o
# AI_GROWTH_HACKING_MODEL=openai/gpt-4o-mini
# AI_SCENARIOS_MODEL=openai/gpt-4o
# AI_OKRS_MODEL=openai/gpt-4o
# AI_BSC_MODEL=openai/gpt-4o-mini
# AI_DECISION_MATRIX_MODEL=openai/gpt-4o
# AI_SYNTHESIS_MODEL=openai/gpt-4o

# ==============================================
# INFRASTRUCTURE
# ==============================================
# Redis (Required for Job Queue)
# Local: localhost:6379
# Prod (e.g. Upstash/Railway): rediss://user:pass@host:port
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# Gotenberg (Required for PDF Generation)
# You must host this Docker container yourself.
# Local: http://localhost:3000
# Prod: https://your-gotenberg-service.railway.app
GOTENBERG_URL=http://localhost:3000

# ==============================================
# APPLICATION TUNING
# ==============================================
# Enable background worker (true/false or 1/0)
# If false, jobs must be triggered manually via admin retry endpoints
WORKER_ENABLED=true
ASYNQ_CONCURRENCY=10
RATE_LIMIT_REQUESTS_PER_MINUTE=100
