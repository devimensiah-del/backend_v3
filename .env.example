# ==============================================
# SERVER SETTINGS
# ==============================================
# REQUIRED: Port for the Go backend to listen on (1-65535)
SERVER_PORT=8080

# REQUIRED: Environment - affects logging and validation ("development" or "production")
ENV=development

# OPTIONAL: Comma-separated list of allowed CORS origins
# Production: Must NOT include localhost
ALLOWED_ORIGINS=http://localhost:3000,https://your-production-domain.com

# ==============================================
# DATABASE (Supabase PostgreSQL)
# ==============================================
# REQUIRED: PostgreSQL connection string
# Format: postgres://user:password@host:port/dbname?sslmode=require
# Get from: Supabase -> Settings -> Database -> Connection String (Go)
# Production: MUST include sslmode=require or stronger
DATABASE_URL=postgres://postgres.xxxx:password@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=require

# OPTIONAL: Database connection pool settings
# DB_MAX_OPEN_CONNS: Maximum open connections (default: 25, range: 1+)
# DB_MAX_IDLE_CONNS: Maximum idle connections (default: 5, must be <= DB_MAX_OPEN_CONNS)
# DB_CONN_MAX_LIFETIME_MINUTES: Connection max lifetime in minutes (default: 5, range: 1+)
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME_MINUTES=5

# ==============================================
# SUPABASE INTEGRATION
# ==============================================
# REQUIRED: Supabase project URL
# Format: https://your-project-id.supabase.co
# Get from: Supabase -> Settings -> API -> Project URL
SUPABASE_URL=https://your-project-id.supabase.co

# REQUIRED: Anon key for Auth API calls (signup/login/logout)
# Get from: Supabase -> Settings -> API -> Project API keys -> anon public
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# REQUIRED: JWT Secret for validating user tokens in AuthMiddleware
# Get from: Supabase -> Settings -> API -> JWT Settings -> JWT Secret
# SECURITY: MUST be at least 32 characters and cryptographically random
# SECURITY: Cannot contain words like "secret", "test", "example", "default", etc.
SUPABASE_JWT_SECRET=your-actual-jwt-secret-from-supabase-at-least-32-chars

# REQUIRED: Service role key for storage uploads (never expose to frontend)
# Get from: Supabase -> Settings -> API -> Project API keys -> service_role
SUPABASE_SERVICE_ROLE_KEY=service-role-key-with-storage-rights

# OPTIONAL: Signed URL TTL for downloads in seconds (default: 604800 = 7 days, minimum: 60)
SUPABASE_SIGNED_URL_TTL=604800

# ==============================================
# AI/LLM CONFIGURATION (OpenRouter)
# ==============================================
# REQUIRED: OpenRouter API key (must start with "sk-or-")
# Get from: https://openrouter.ai/keys
# Note: Set as OPENAI_API_KEY for SDK compatibility
OPENAI_API_KEY=sk-or-v1-your-openrouter-api-key

# ==============================================
# AI MODEL CONFIGURATION (3-Model Approach)
# ==============================================
# The system uses 3 models with automatic fallback on rate limits/failures:
#
# 1. PRESEARCH: Perplexity for company enrichment (inline at company creation)
#    - Company identification and data gathering
#    - Used by: Enrichment service
#
# 2. PRIMARY: Used for ALL 11 analysis frameworks
#    - Frameworks: PESTEL, Porter, TAM-SAM-SOM, SWOT, Benchmarking
#                  Blue Ocean, Growth Hacking, Scenarios, OKRs, BSC, Decision Matrix
#    - Used by: Analysis service
#
# 3. SYNTHESIS: Premium model for executive summary
#    - Used by: Final synthesis step combining all framework results
#
# Each model has a fallback for automatic retry on rate limits/timeouts

# OPTIONAL: PreSearch model for enrichment (default: perplexity/sonar-pro)
AI_PRESEARCH_MODEL=perplexity/sonar-pro
AI_PRESEARCH_FALLBACK=perplexity/sonar

# OPTIONAL: Primary model for all 11 frameworks (default: google/gemini-2.5-flash)
AI_PRIMARY_MODEL=google/gemini-2.5-flash
AI_PRIMARY_FALLBACK=openai/gpt-4.1-mini

# OPTIONAL: Synthesis model for executive summary (default: google/gemini-2.5-pro-preview)
AI_SYNTHESIS_MODEL=google/gemini-2.5-pro-preview
AI_SYNTHESIS_FALLBACK=openai/gpt-4.1

# OPTIONAL: Temperature for AI generation (0.0-2.0, default: 0.5)
# Lower = more deterministic, Higher = more creative
AI_TEMPERATURE=0.5

# OPTIONAL: Max tokens per task type (range: 100-100000)
AI_MAX_TOKENS_ENRICHMENT=2000  # Enrichment (default: 2000)
AI_MAX_TOKENS_ANALYSIS=8000    # Analysis frameworks (default: 8000)
AI_MAX_TOKENS_SYNTHESIS=6000   # Executive summary (default: 6000)

# ==============================================
# REDIS CONFIGURATION (Job Queue)
# ==============================================
# Redis is REQUIRED for background job processing (Asynq)
#
# Option 1: REDIS_URL (Railway/Cloud format, takes precedence)
# Format: redis://default:password@host:port or rediss://... for TLS
# REDIS_URL=redis://default:your-password@redis.railway.internal:6379
#
# Option 2: REDIS_ADDR + REDIS_PASSWORD (local development)
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# ==============================================
# WORKER CONFIGURATION (Background Jobs)
# ==============================================
# OPTIONAL: Enable background workers (default: true)
# If false, jobs must be triggered manually via admin retry endpoints
WORKER_ENABLED=true

# OPTIONAL: Worker concurrency (1-100, default: 10)
ASYNQ_CONCURRENCY=10

# OPTIONAL: Queue priority weights (default: critical:6,default:3,low:1)
WORKER_QUEUES=critical:6,default:3,low:1

# OPTIONAL: Job timeout settings in seconds
# ENRICHMENT_TIMEOUT: Enrichment job timeout (10-3600, default: 300 = 5min)
# ANALYSIS_TIMEOUT: Analysis job timeout (10-3600, default: 900 = 15min)
ENRICHMENT_TIMEOUT=300
ANALYSIS_TIMEOUT=900

# OPTIONAL: Job retry settings
# Max retries (0-10)
ENRICHMENT_MAX_RETRIES=3
ANALYSIS_MAX_RETRIES=2

# Retry delay in seconds
# JOB_RETRY_INITIAL_DELAY: Initial delay (1-3600, default: 60)
# JOB_RETRY_MAX_DELAY: Max delay (must be >= initial, default: 3600 = 1h)
JOB_RETRY_INITIAL_DELAY=60
JOB_RETRY_MAX_DELAY=3600

# Dead letter queue TTL in hours (default: 168 = 7 days)
DLQ_TTL_HOURS=168

# ==============================================
# MACRO SCHEDULER
# ==============================================
# OPTIONAL: Enable macro data cron jobs (SELIC, IPCA, USD/BRL auto-fetch)
# Set to false to disable all scheduled macro data fetches
# Individual indicators can still be toggled via Supabase (macro_indicator_types.is_active)
MACRO_SCHEDULER_ENABLED=true

# ==============================================
# STORAGE & FRONTEND
# ==============================================
# OPTIONAL: Local file storage path (default: ./uploads)
STORAGE_BASE_PATH=./uploads

# OPTIONAL: Public URL for uploaded files (default: http://localhost:8080/uploads)
STORAGE_BASE_URL=http://localhost:8080/uploads

# OPTIONAL: Frontend application URL (default: http://localhost:3000)
FRONTEND_URL=http://localhost:3000
