# ==============================================
# SERVER SETTINGS
# ==============================================
# Port for the Go backend to listen on
SERVER_PORT=8080
# Environment: "development" or "production"
ENV=development
# The URL of your frontend (React/Next.js) for CORS
ALLOWED_ORIGINS=http://localhost:3000,https://your-production-domain.com

# ==============================================
# DATABASE (Supabase PostgreSQL)
# ==============================================
# Format: postgres://user:password@host:port/dbname?sslmode=disable
# Get this from Supabase -> Settings -> Database -> Connection String (Go)
DATABASE_URL=postgres://postgres.xxxx:password@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=require

# ==============================================
# AUTHENTICATION (Supabase Auth)
# ==============================================
# The Project URL
SUPABASE_URL=https://your-project-id.supabase.co
# CRITICAL: The "JWT Secret" (not the Anon Key). 
# Found in Supabase -> Settings -> API -> JWT Settings
SUPABASE_JWT_SECRET=super-secret-jwt-token-from-supabase-settings

# ==============================================
# AI BRAIN (OpenRouter)
# ==============================================
# Key starting with "sk-or-..."
OPENROUTER_API_KEY=sk-or-your-openrouter-key
# The Dream Team Architecture
AI_ENRICHMENT_MODEL=google/gemini-2.0-flash-001
AI_ANALYSIS_MODEL=google/gemini-2.0-pro-exp-02-05
AI_SYNTHESIS_MODEL=anthropic/claude-3.5-sonnet

# ==============================================
# INFRASTRUCTURE
# ==============================================
# Redis (Required for Job Queue)
# Local: localhost:6379
# Prod (e.g. Upstash/Railway): rediss://user:pass@host:port
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# Gotenberg (Required for PDF Generation)
# You must host this Docker container yourself.
# Local: http://localhost:3000
# Prod: https://your-gotenberg-service.railway.app
GOTENBERG_URL=http://localhost:3000

# ==============================================
# APPLICATION TUNING
# ==============================================
ASYNQ_CONCURRENCY=10
RATE_LIMIT_REQUESTS_PER_MINUTE=100