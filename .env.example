# ==============================================
# SERVER SETTINGS
# ==============================================
# Port for the Go backend to listen on
SERVER_PORT=8080
# Environment: "development" or "production"
ENV=development
# The URL of your frontend (React/Next.js) for CORS
ALLOWED_ORIGINS=http://localhost:3000,https://your-production-domain.com

# ==============================================
# DATABASE (Supabase PostgreSQL)
# ==============================================
# Format: postgres://user:password@host:port/dbname?sslmode=disable
# Get this from Supabase -> Settings -> Database -> Connection String (Go)
DATABASE_URL=postgres://postgres.xxxx:password@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=require

# ==============================================
# AUTHENTICATION (Supabase Auth)
# ==============================================
# The Project URL
SUPABASE_URL=https://your-project-id.supabase.co

# CRITICAL: Two different keys are required:
# 1. Anon Key: Public key for making Auth API calls (signup/login/logout)
#    Found in: Supabase -> Settings -> API -> Project API keys -> anon public
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. JWT Secret: Secret for validating user tokens in AuthMiddleware
#    Found in: Supabase -> Settings -> API -> JWT Settings -> JWT Secret
SUPABASE_JWT_SECRET=super-secret-jwt-token-from-supabase-settings

# ==============================================
# AI BRAIN (OpenRouter)
# ==============================================
# Key starting with "sk-or-..."
OPENROUTER_API_KEY=sk-or-your-openrouter-key

# ==============================================
# STRATEGIC CASCADE HETEROGENEOUS MODEL CONFIGURATION
# Framework-specific model and temperature routing for optimal performance
# ==============================================

# --- Layer 0: Enrichment (Discovery) ---
AI_ENRICHMENT_MODEL=google/gemini-2.0-flash-001
AI_ENRICHMENT_TEMP=0.5
AI_ENRICHMENT_MAX_TOKENS=8000

# --- Layer 1: Environment Scanning ---
# PESTEL (Logic-gated, strict instruction-following)
AI_PESTEL_MODEL=openai/o3-mini
AI_PESTEL_TEMP=0.2
AI_PESTEL_MAX_TOKENS=300

# Porter 5 Forces (Structural reasoning)
AI_PORTER_MODEL=anthropic/claude-3.5-sonnet
AI_PORTER_TEMP=0.3
AI_PORTER_MAX_TOKENS=250

# TAM/SAM/SOM (Mathematical precision)
AI_TAM_MODEL=openai/o3-mini
AI_TAM_TEMP=0.1
AI_TAM_MAX_TOKENS=350

# --- Layer 2: Positioning ---
# SWOT (Balanced, good at prioritization)
AI_SWOT_MODEL=google/gemini-2.0-pro-exp-02-05
AI_SWOT_TEMP=0.4
AI_SWOT_MAX_TOKENS=200

# Benchmarking (Comparative analysis)
AI_BENCHMARKING_MODEL=google/gemini-2.0-pro-exp-02-05
AI_BENCHMARKING_TEMP=0.35
AI_BENCHMARKING_MAX_TOKENS=220

# --- Layer 3: Strategy ---
# Blue Ocean ERRC (Creative divergence)
AI_BLUE_OCEAN_MODEL=anthropic/claude-3.5-sonnet
AI_BLUE_OCEAN_TEMP=0.7
AI_BLUE_OCEAN_MAX_TOKENS=300

# Growth Hacking (Hypothesis generation)
AI_GROWTH_HACKING_MODEL=anthropic/claude-3.5-sonnet
AI_GROWTH_HACKING_TEMP=0.6
AI_GROWTH_HACKING_MAX_TOKENS=250

# Scenarios (Narrative depth)
AI_SCENARIOS_MODEL=google/gemini-3.0-pro
AI_SCENARIOS_TEMP=0.6
AI_SCENARIOS_MAX_TOKENS=400

# --- Layer 4: Execution ---
# OKRs (Metric alignment)
AI_OKRS_MODEL=openai/o3-mini
AI_OKRS_TEMP=0.25
AI_OKRS_MAX_TOKENS=200

# Balanced Scorecard (Systems thinking)
AI_BSC_MODEL=anthropic/claude-3.5-sonnet
AI_BSC_TEMP=0.35
AI_BSC_MAX_TOKENS=220

# Decision Matrix (Multi-criteria weighted scoring)
AI_DECISION_MATRIX_MODEL=openai/o3-mini
AI_DECISION_MATRIX_TEMP=0.2
AI_DECISION_MATRIX_MAX_TOKENS=300

# --- Synthesis Layer ---
AI_SYNTHESIS_MODEL=anthropic/claude-3.5-sonnet
AI_SYNTHESIS_TEMP=0.4
AI_SYNTHESIS_MAX_TOKENS=3000

# ==============================================
# DEPRECATED (Backward compatibility - use framework-specific above)
# ==============================================
# AI_ANALYSIS_MODEL=google/gemini-2.0-pro-exp-02-05

# ==============================================
# INFRASTRUCTURE
# ==============================================
# Redis (Required for Job Queue)
# Local: localhost:6379
# Prod (e.g. Upstash/Railway): rediss://user:pass@host:port
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# Gotenberg (Required for PDF Generation)
# You must host this Docker container yourself.
# Local: http://localhost:3000
# Prod: https://your-gotenberg-service.railway.app
GOTENBERG_URL=http://localhost:3000

# ==============================================
# APPLICATION TUNING
# ==============================================
# Enable background worker (true/false or 1/0)
# If false, jobs must be triggered manually via admin retry endpoints
WORKER_ENABLED=true
ASYNQ_CONCURRENCY=10
RATE_LIMIT_REQUESTS_PER_MINUTE=100