# 2. Enrichment - Data gathering (must support search)
AI_ENRICHMENT_MODEL=google/gemini-3-pro-preview
AI_ENRICHMENT_FALLBACK=google/gemini-2.5-pro-preview

# 3. Primary - All 11 analysis frameworks
AI_PRIMARY_MODEL=openai/gpt-5.1
AI_PRIMARY_FALLBACK=google/gemini-3-pro-preview

# 4. Synthesis - Executive summary (premium)
AI_SYNTHESIS_MODEL=anthropic/claude-opus-4.5
AI_SYNTHESIS_FALLBACK=google/gemini-3-pro-preview

# Shared settings
AI_TEMPERATURE=0.5
AI_MAX_TOKENS_ENRICHMENT=10000
AI_MAX_TOKENS_ANALYSIS=10000
AI_MAX_TOKENS_SYNTHESIS=10000

