  "test_scenarios": {
    "successful_upload": {
      "description": "Successful PDF upload to reports bucket",
      "input": {
        "bucket": "reports",
        "path": "test-submission-789/report-v1.pdf",
        "content_type": "application/pdf"
      },
      "expected_output": {
        "public_url": "https://mock-project.supabase.co/storage/v1/object/public/reports/test-submission-789/report-v1.pdf",
        "status_code": 201
      }
    },
    "upload_with_upsert": {
      "description": "Upload with x-upsert header to overwrite existing file",
      "input": {
        "bucket": "reports",
        "path": "test-submission-123/report-v1.pdf",
        "content_type": "application/pdf",
        "headers": {
          "x-upsert": "true"
        }
      },
      "expected_output": {
        "public_url": "https://mock-project.supabase.co/storage/v1/object/public/reports/test-submission-123/report-v1.pdf",
        "status_code": 200
      }
    },
    "bucket_not_found": {
      "description": "Attempt to upload to non-existent bucket",
      "input": {
        "bucket": "invalid-bucket",
        "path": "test.pdf",
        "content_type": "application/pdf"
      },
      "expected_output": {
        "error": "Bucket not found",
        "status_code": 404
      }
    },
    "unauthorized_upload": {
      "description": "Upload without proper authorization token",
      "input": {
        "bucket": "reports",
        "path": "unauthorized.pdf",
        "content_type": "application/pdf",
        "headers": {
          "Authorization": "Bearer invalid-token"
        }
      },
      "expected_output": {
        "error": "Unauthorized",
        "status_code": 401
      }
    }
  },
  "config": {
    "project_url": "https://mock-project.supabase.co",
    "default_bucket": "reports",
    "max_file_size": 52428800,
    "allowed_content_types": [
      "application/pdf",
      "application/json",
      "text/plain"
    ]
  }
