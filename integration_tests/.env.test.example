# Integration Test Environment Configuration
# Copy this file to backend_v3/.env for running integration tests

# ==============================================
# REQUIRED: Database for Integration Tests
# ==============================================
# Option 1: Local PostgreSQL for testing
DATABASE_URL=postgres://postgres:postgres@localhost:5432/imensiah_test?sslmode=disable

# Option 2: Use your development database (not recommended)
# DATABASE_URL=postgres://user:password@localhost:5432/imensiah_dev?sslmode=disable

# ==============================================
# OPTIONAL: Real Service Integration
# ==============================================
# If these are NOT set, tests will automatically use mocks
# Set these ONLY if you want to test against real services

# OpenRouter API Key (leave empty for mock mode)
OPENROUTER_API_KEY=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

# Supabase Configuration (leave empty for mock mode)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key-here

# ==============================================
# Test Setup Instructions
# ==============================================
#
# 1. Install PostgreSQL locally (if not already installed)
#    - Windows: https://www.postgresql.org/download/windows/
#    - Mac: brew install postgresql
#    - Linux: sudo apt-get install postgresql
#
# 2. Create a test database:
#    psql -U postgres
#    CREATE DATABASE imensiah_test;
#    \q
#
# 3. Run migrations (from backend_v3 directory):
#    psql -U postgres -d imensiah_test -f migrations/001_initial_schema.sql
#    # Run all migration files in order...
#
# 4. Copy this file:
#    cp .env.test.example ../.env
#    # Or create ../env with the DATABASE_URL above
#
# 5. Run tests:
#    cd integration_tests
#    go test -v
#
# ==============================================
# Notes
# ==============================================
# - Tests will SKIP if no valid DATABASE_URL is found
# - Tests use MOCKS for OpenRouter/Supabase by default
# - Set OPENROUTER_API_KEY only if testing with real LLM
# - Set SUPABASE_URL only if testing with real storage
